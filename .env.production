# Live FX rate provider (used by the New Purchase wizard).
# Default: open.er-api.com — CORS-friendly, free, no API key required.
# Fetcher appends "/<FROM>" → e.g. https://open.er-api.com/v6/latest/USD
# Returns { rates: { JOD: 0.7094, ... } }. Override here with any provider
# that returns the same shape:
NEXT_PUBLIC_FX_API_URL=https://open.er-api.com/v6/latest
# NEXT_PUBLIC_FX_API_KEY=your-key-here

# Catalogue (public shop) hosts. Any visit to these domains gets rewritten
# to /shop so anon visitors see the read-only catalogue. Comma-separated.
# Empty by default — visitors reach the catalogue via /shop on the apex
# (zaman-jo.com/shop, zaman-watch.vercel.app/shop). Set this if you later
# buy a dedicated shop domain (e.g. shop.zaman-jo.com).
# NEXT_PUBLIC_CATALOGUE_HOSTS=shop.zaman-jo.com
